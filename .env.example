# Register an app at https://stepik.org/oauth2/applications/
# Client type: confidential
#
# For enrolled / paid courses (recommended):
#   Authorization grant type = password
#   Fill CLIENT_ID/SECRET + USERNAME/PASSWORD below
#
# For public courses only:
#   Authorization grant type = client-credentials
#   Fill only CLIENT_ID/SECRET (leave username/password empty)
#   or set STEPIK_GRANT_TYPE=client_credentials

STEPIK_CLIENT_ID=
STEPIK_CLIENT_SECRET=

STEPIK_USERNAME=
STEPIK_PASSWORD=

# Optional: force grant type (password | client_credentials)
# STEPIK_GRANT_TYPE=password

# Optional overrides
# STEPIK_API_HOST=https://stepik.org
# STEPIK_COURSES_DIR=courses
